# Copy to .env and fill in. Real environment variables win over this file.

# Bot from @BotFather
BOT_TOKEN=
# Your Telegram id: the owner hands out invite codes and manages users
OWNER_ID=
# Claude Haiku lays out the sheets' tabs: which columns are graded works
ANTHROPIC_API_KEY=

# Optional. Dollars a month for laying out tabs; new tabs wait for the next month beyond it
# LLM_MONTHLY_USD=1

# Optional. How many days an invite code works, 1 to 90
# INVITE_DAYS=7
# Optional. Time zone for quiet hours and the dates the bot shows
# TZ=Europe/Moscow
# Optional. A local Bot API server instead of api.telegram.org
# BOT_API_URL=

# Optional. DNS servers of the container (compose.yaml); 1.1.1.1 and 9.9.9.9 when empty
CONTAINER_DNS_1=
CONTAINER_DNS_2=
